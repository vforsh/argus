{
	"name": "@vforsh/argus-extension",
	"version": "0.2.0",
	"description": "Argus CDP Bridge Chrome Extension",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vforsh/argus.git",
		"directory": "packages/argus-extension"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"build": "esbuild src/background/service-worker.ts src/popup/popup.ts --bundle --outdir=dist --format=esm --target=chrome120 --sourcemap",
		"generate-key": "node scripts/generate-key.mjs",
		"package:release": "node scripts/package-release.mjs",
		"watch": "bun run build -- --watch",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/chrome": "^0.0.287",
		"@vforsh/argus-core": "^0.4.0",
		"esbuild": "0.25.12"
	}
}
