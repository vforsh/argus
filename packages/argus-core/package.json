{
	"name": "@vforsh/argus-core",
	"version": "0.3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vforsh/argus.git",
		"directory": "packages/argus-core"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./error-message": {
			"types": "./dist/errorMessage.d.ts",
			"default": "./dist/errorMessage.js"
		},
		"./native-messaging": {
			"types": "./dist/protocol/native-messaging.d.ts",
			"default": "./dist/protocol/native-messaging.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "node ../../scripts/clean-dist.mjs",
		"build": "npm run clean && tsc -b",
		"typecheck": "tsc -b --pretty false --noEmit"
	}
}
